# 复制本文件为 .env 后填写。所有字段都可以在 Web 界面的“设置”页中修改，
# 数据库中的设置会覆盖这里的默认值。

# 闲鱼登录 Cookie：登录 https://www.goofish.com 后，从浏览器开发者工具复制 Cookie
XIANYU_COOKIE=

# OpenAI 兼容大模型服务（推荐智谱：https://open.bigmodel.cn/api/paas/v4，模型名小写）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash

# Server酱 SendKey（https://sct.ftqq.com），留空则不推送微信
SERVERCHAN_SENDKEY=

# 视觉模型（阶段二看图；推荐智谱 glm-4.6v-flash / glm-4.1v-thinking-flash，免费；不填则跳过品相分析）
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=glm-4.6v-flash

# 消息通知开关
SERVERCHAN_ENABLED=true
WECOM_WEBHOOK=
WECOM_ROBOT_ENABLED=true

# 视觉模型开关
VISION_ENABLED=true

# 可选 HTTP 代理，例如 http://127.0.0.1:7890
PROXY=

# 默认抓取间隔（分钟）与随机抖动（分钟）
DEFAULT_CRAWL_INTERVAL_MINUTES=20
DEFAULT_CRAWL_JITTER_MINUTES=10

# SQLite 数据库文件路径
DATABASE_URL=sqlite:///data/goodprice.db
