# 复制本文件为 .env 后填写。所有字段都可以在 Web 界面的“设置”页中修改，
# 数据库中的设置会覆盖这里的默认值。

# 闲鱼登录 Cookie：登录 https://www.goofish.com 后，从浏览器开发者工具复制 Cookie
XIANYU_COOKIE=

# OpenAI 兼容大模型服务（推荐智谱：https://open.bigmodel.cn/api/paas/v4，模型名小写）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
# chat_completions 或 responses；Codex bridge 使用 responses
LLM_API_FORMAT=chat_completions

# Server酱 SendKey（https://sct.ftqq.com），留空则不推送微信
SERVERCHAN_SENDKEY=

# 视觉模型（阶段二看图；推荐智谱 glm-4.6v-flash / glm-4.1v-thinking-flash，免费；不填则跳过品相分析）
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=glm-4.6v-flash
VISION_API_FORMAT=chat_completions

# 消息通知开关
SERVERCHAN_ENABLED=true
WECOM_WEBHOOK=
WECOM_ROBOT_ENABLED=true

# 飞书自定义机器人 Webhook 与签名密钥（可选）
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_ENABLED=true

# Gotify（自托管通知）
GOTIFY_URL=http://gotify
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
GOTIFY_ENABLED=true

# 视觉模型开关
VISION_ENABLED=true

# Jev 判断层（实验性）：需求匹配与性价比逐件独立评估，低置信回落原模型。
# backend=adapter 复用上面的 LLM_* 配置（免费）；
# backend=typesafe 直连官方 Jev 云服务，需在 console.typesafe.ai/keys 获取 API Key。
JEV_ENABLED=false
JEV_AUTO_THRESHOLD=0.85
JEV_BACKEND=adapter
JEV_API_KEY=

# 可选 HTTP 代理，例如 http://127.0.0.1:7890
PROXY=

# 默认抓取间隔（分钟）与随机抖动（分钟）
DEFAULT_CRAWL_INTERVAL_MINUTES=20
DEFAULT_CRAWL_JITTER_MINUTES=10

# Docker 端口绑定地址：本机使用 127.0.0.1；NAS 需要局域网访问时可填 NAS 局域网 IP（不建议无认证暴露到公网）
BIND_ADDRESS=127.0.0.1

# Docker 镜像标签：本地构建时用 second-eye:local；也可指向已发布镜像
SECOND_EYE_IMAGE=second-eye:local

# SQLite 数据库文件路径（Docker 部署时会被 compose.yml 的 environment 覆盖为
# sqlite:////app/data/goodprice.db，容器内改这里不生效）
DATABASE_URL=sqlite:///data/goodprice.db
# 日志与后续媒体缓存目录；测试/独立部署可指定其他目录。
DATA_ROOT=data

# Docker noVNC：默认关闭。临时登录时设置 ENABLE_NOVNC=1，并在 data/.novnc-password
# 写入独立密码；登录完成后恢复为 0 并重启容器。
ENABLE_NOVNC=0
NOVNC_PASSWORD_FILE=/app/data/.novnc-password
# noVNC 对外端口（compose 端口映射与登录页链接共用；需与 BIND_ADDRESS 一起对外可达）
NOVNC_PORT=16080
# 媒体预算：提高数量会增加模型用量、延迟、内存和磁盘；不自动拆分付费请求。
VIDEO_ANALYSIS_ENABLED=false
MEDIA_IMAGE_COUNT=8
MEDIA_VIDEO_COUNT=1
MEDIA_FRAMES_PER_VIDEO=6
MEDIA_IMAGE_QUOTA=4
MEDIA_FRAME_QUOTA=4
MEDIA_TOTAL_LIMIT=8
# 未知模型上限保守8；只有确认提供商支持后才提高，最高16。
MEDIA_MODEL_LIMIT=8
MEDIA_VIDEO_MAX_MIB=100
MEDIA_VIDEO_MAX_SECONDS=180
MEDIA_CACHE_MIB=1024
MEDIA_RETENTION_DAYS=7
MEDIA_DOWNLOAD_TIMEOUT=60
MEDIA_DECODE_TIMEOUT=30
MEDIA_REQUEST_MAX_MIB=16
MEDIA_FFMPEG_THREADS=1
# 分阶段执行预算（设备建议不自动提高访问频率或模型RPM）
EXECUTION_ACTIVE_RUNS=2
EXECUTION_CRAWLER_WORKERS=1
EXECUTION_MODEL_WORKERS=1
EXECUTION_MEDIA_WORKERS=1
EXECUTION_PLATFORM_INTERVAL_SECONDS=10
EXECUTION_MODEL_RPM=10
EXECUTION_GLOBAL_ITEMS=200
EXECUTION_TASK_ITEMS=60
EXECUTION_RUN_DETAILS=30
EXECUTION_RUN_HTTP_ATTEMPTS=60
EXECUTION_RUN_MINUTES=15
