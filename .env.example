# 复制本文件为 .env 后填写。所有字段都可以在 Web 界面的“设置”页中修改，
# 数据库中的设置会覆盖这里的默认值。

# 闲鱼登录 Cookie：登录 https://www.goofish.com 后，从浏览器开发者工具复制 Cookie
XIANYU_COOKIE=

# OpenAI 兼容大模型服务（推荐智谱：https://open.bigmodel.cn/api/paas/v4，模型名小写）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
# chat_completions 或 responses；Codex bridge 使用 responses
LLM_API_FORMAT=chat_completions

# Server酱 SendKey（https://sct.ftqq.com），留空则不推送微信
SERVERCHAN_SENDKEY=

# 视觉模型（阶段二看图；推荐智谱 glm-4.6v-flash / glm-4.1v-thinking-flash，免费；不填则跳过品相分析）
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=glm-4.6v-flash
VISION_API_FORMAT=chat_completions

# 消息通知开关
SERVERCHAN_ENABLED=true
WECOM_WEBHOOK=
WECOM_ROBOT_ENABLED=true

# 飞书自定义机器人 Webhook 与签名密钥（可选）
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_ENABLED=true

# Gotify（自托管通知）
GOTIFY_URL=http://gotify
GOTIFY_TOKEN=
GOTIFY_PRIORITY=5
GOTIFY_ENABLED=true

# 视觉模型开关
VISION_ENABLED=true

# 可选 HTTP 代理，例如 http://127.0.0.1:7890
PROXY=

# 默认抓取间隔（分钟）与随机抖动（分钟）
DEFAULT_CRAWL_INTERVAL_MINUTES=20
DEFAULT_CRAWL_JITTER_MINUTES=10

# SQLite 数据库文件路径
DATABASE_URL=sqlite:///data/goodprice.db

# Docker noVNC：默认关闭。临时登录时设置 ENABLE_NOVNC=1，并在 data/.novnc-password
# 写入独立密码；登录完成后恢复为 0 并重启容器。
ENABLE_NOVNC=0
NOVNC_PASSWORD_FILE=/app/data/.novnc-password
